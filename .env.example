# ===== GUI / Dashboard =====
# Wajib di-set jika dashboard diakses dari luar localhost.
# Tanpa token, server hanya bind 127.0.0.1 (aman untuk penggunaan lokal).
#
# CARA MEMBUAT TOKEN (jalankan di terminal):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# lalu tempel hasilnya di bawah, contoh:
#   DASHBOARD_TOKEN=x7Kp2mQ9vN4sL8tW3rY6uJ1cA5dE0fGh
# Login via halaman /login. Jangan commit .env ke git.
DASHBOARD_TOKEN=
# Opsional: host bind (default: 127.0.0.1 tanpa token, 0.0.0.0 dengan token).
# Rekomendasi: biarkan 127.0.0.1 + akses jarak jauh via Tailscale/SSH tunnel.
HOST=127.0.0.1

# ===== WhatsApp (Selenium) =====
# "1" untuk mode headless; "1" juga berarti non-interaktif (tidak menunggu scan QR di terminal)
WA_HEADLESS=0
# "1" = jangan blok menunggu input() saat WA belum login (dipakai GUI/CI)
WA_NONINTERACTIVE=0
