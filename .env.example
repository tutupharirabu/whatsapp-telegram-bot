# Telegram API credentials (dapatkan dari https://my.telegram.org)
# Digunakan untuk cek & kirim pesan via Telethon (user account, bukan bot)
# Semua nilai di bawah ini adalah contoh/dummy — ganti dengan punyamu sendiri!
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+6281234567890   ← ini contoh, ganti dengan nomor HP kamu!

# WhatsApp Web Check (Selenium)
# Set "1" untuk mode headless (background, tanpa window)
# Kosongkan atau "0" untuk mode tampil
WA_HEADLESS=0

# Nama aplikasi browser untuk auto-activate (osascript) sebelum Enter ditekan
WA_BROWSER_APP=Arc

# Nama fasilitator (pisahkan dengan koma)
# Digunakan oleh extract_facilitators.py untuk filter dari daily report
FASIL_NAMES=Irfan Zharauri,Nafila Alfirahma
